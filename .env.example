# Fan360 Environment Configuration Placeholder
# Copy to .env for local runtime configuration. Never commit real credentials.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fan360
DB_USER=postgres
DB_PASSWORD=

# LLM Provider Configuration (Optional)
# If LLM_API_KEY is not provided, Fan360 automatically operates in Mock LLM mode.
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
