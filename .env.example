# Fan360 Environment Configuration Placeholder
# Copy to .env for local runtime configuration. Never commit real credentials.

# Database Configuration
FAN360_DB_HOST=localhost
FAN360_DB_PORT=5432
FAN360_DB_NAME=fan360
FAN360_DB_USER=postgres
FAN360_DB_PASSWORD=

# LLM Provider Configuration
# Supported LLM_MODE: 'mock' (default deterministic local mode) or 'live' (requires LLM_API_KEY)
LLM_MODE=mock
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
